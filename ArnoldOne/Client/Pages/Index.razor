@page "/"
@inherits PageComponentBase

<ErrorAlert Message="@ErrorMessage" OnClose="ClearError" />

<MudText Typo="Typo.h1">Arnold</MudText>
<MudText Typo="Typo.h3">PPL 1</MudText>
<MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="/TP/split/2/pass/1?new=1">Dag 1</MudButton>
<MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="/TP/split/2/pass/2?new=1">Dag 2</MudButton>
<MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="/TP/split/2/pass/3?new=1">Dag 3</MudButton>
<MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="/TP/split/2/pass/4?new=1">Dag 4</MudButton>

<MudText Typo="Typo.h3">PPL 2</MudText>
<MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="/TP/split/1/pass/1?new=1">Push</MudButton>
<MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="/TP/split/1/pass/2?new=1">Pull</MudButton>
<MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="/TP/split/1/pass/3?new=1">Legs</MudButton>
<MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="/TP/split/1/pass/4?new=1">Axel/underarmar</MudButton>

<MudText Typo="Typo.h3">Templates</MudText>
<MudButton Variant="Variant.Filled" Color="Color.Tertiary" Href="/TP/templates">Split template</MudButton>

<MudText Typo="Typo.h3">Övningar per passtemplate</MudText>
@foreach (var split in exerciseCounts.GroupBy(e => e.SplitTemplateName))
{
    <MudText Typo="Typo.h5">@split.Key</MudText>
    @foreach (var pass in split)
    {
        <MudText>@pass.PassTemplateName: @pass.ExerciseCount övningar</MudText>
    }
}
