@page "/"
@inherits PageComponentBase

<PageTitle>@(LoginState.IsLoggedIn ? "Min träning" : "Arnold – Träning på ditt sätt")</PageTitle>
<ErrorAlert Message="@ErrorMessage" OnClose="ClearError" />

@if (!LoginState.IsLoggedIn)
{
    <section class="home-hero">
        <div class="home-hero__content">
            <MudText Typo="Typo.overline" Class="home-eyebrow">ARNOLD TRAINING</MudText>
            <MudText Typo="Typo.h1" Class="home-title">Bygg ditt upplägg.<br />Träna med fokus.</MudText>
            <MudText Typo="Typo.h6" Class="home-lead">
                Skapa splits som passar dig, följ passen steg för steg och bygg en träningshistorik som håller över tid.
            </MudText>
            <div class="home-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenRegisterDialog">
                    Skapa konto
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Login" OnClick="OpenLoginDialog">
                    Logga in
                </MudButton>
            </div>
        </div>
        <MudPaper Class="home-hero__panel pa-6" Elevation="6">
            <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Class="home-hero__icon" />
            <MudText Typo="Typo.h5">Ditt nästa pass är alltid nära</MudText>
            <MudText Color="Color.Secondary">Välj split, starta ett pass och fortsätt där du slutade.</MudText>
        </MudPaper>
    </section>

    <MudGrid Class="mt-8">
        <MudItem xs="12" md="4">
            <MudPaper Class="home-feature pa-5" Outlined="true">
                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h6">Planera</MudText>
                <MudText Color="Color.Secondary">Bygg egna splits eller utgå från färdiga mallar.</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="home-feature pa-5" Outlined="true">
                <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Color="Color.Secondary" Size="Size.Large" />
                <MudText Typo="Typo.h6">Genomför</MudText>
                <MudText Color="Color.Secondary">Logga set, reps och vikt utan att tappa flytet.</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="home-feature pa-5" Outlined="true">
                <MudIcon Icon="@Icons.Material.Filled.Insights" Color="Color.Tertiary" Size="Size.Large" />
                <MudText Typo="Typo.h6">Följ utvecklingen</MudText>
                <MudText Color="Color.Secondary">Historiken behåller sammanhanget när ditt upplägg förändras.</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
}
else
{
    <div class="dashboard">
        @if (IsLoading || dashboard is null)
        {
            <MudSkeleton Class="dashboard-priority-skeleton" Height="180px" />
        }
        else
        {
            @if (activePass is not null)
            {
                <MudPaper Class="workout-priority workout-priority--active" Elevation="4">
                    <div class="workout-priority__content">
                        <MudText Typo="Typo.overline" Class="workout-priority__label">PÅGÅENDE PASS:</MudText>
                        <MudText Typo="Typo.h3" Class="workout-priority__title">@activePass.PassName</MudText>
                        <MudText Class="workout-priority__meta">@activePass.SplitName</MudText>
                    </div>
                    <MudButton Href="@PassUrl(activePass)"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.PlayArrow">
                        Fortsätt
                    </MudButton>
                </MudPaper>
            }
            else if (nextPass is not null)
            {
                <MudPaper Class="workout-priority" Elevation="4">
                    <div class="workout-priority__content">
                        <MudText Typo="Typo.overline" Class="workout-priority__label">NÄSTA PASS:</MudText>
                        <MudText Typo="Typo.h3" Class="workout-priority__title">@nextPass.PassName</MudText>
                        <MudText Class="workout-priority__meta">@nextPass.SplitName</MudText>
                    </div>
                    <MudButton Href="@PassUrl(nextPass, startNew: true)"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.PlayArrow">
                        Starta
                    </MudButton>
                </MudPaper>
            }
            else
            {
                <MudPaper Class="empty-state dashboard-empty" Outlined="true">
                    <MudText Typo="Typo.h5">Ingen aktiv split</MudText>
                    <div class="home-actions">
                        <MudButton Href="/create-split" Variant="Variant.Filled" Color="Color.Primary">Skapa split</MudButton>
                        <MudButton Href="/TP/templates" Variant="Variant.Outlined" Color="Color.Secondary">Mallar</MudButton>
                    </div>
                </MudPaper>
            }

            <MudText Typo="Typo.h5" Class="dashboard-overview-title">Översikt</MudText>
            <MudGrid>
                <MudItem xs="12" sm="4"><MudPaper Class="dashboard-stat pa-4" Outlined="true"><MudText Typo="Typo.h3">@dashboard.CompletedSessionsLast7Days</MudText><MudText Color="Color.Secondary">7 dagar</MudText></MudPaper></MudItem>
                <MudItem xs="12" sm="4"><MudPaper Class="dashboard-stat pa-4" Outlined="true"><MudText Typo="Typo.h3">@dashboard.CompletedSessionsLast30Days</MudText><MudText Color="Color.Secondary">30 dagar</MudText></MudPaper></MudItem>
                <MudItem xs="12" sm="4"><MudPaper Class="dashboard-stat pa-4" Outlined="true"><MudText Typo="Typo.h3">@dashboard.TotalCompletedSessions</MudText><MudText Color="Color.Secondary">Totalt</MudText></MudPaper></MudItem>
            </MudGrid>

            @if (dashboard.ActiveSplits.Count > 0)
            {
                <div class="section-heading mt-8">
                    <MudText Typo="Typo.h4">Aktiva splits</MudText>
                    <MudButton Href="/TP/my-splits" Variant="Variant.Text" Color="Color.Secondary">Hantera</MudButton>
                </div>

                <MudGrid>
                    @foreach (var split in dashboard.ActiveSplits)
                    {
                        <MudItem xs="12" md="6">
                            <MudCard Class="split-card">
                                <MudCardContent>
                                    <MudText Typo="Typo.h5">@split.SplitName</MudText>
                                    <div class="pass-grid">
                                        @foreach (var pass in split.Passes)
                                        {
                                            <MudButton Href="@($"/TP/split/{split.SplitId}/pass/{pass.PassId}")"
                                                       Variant="Variant.Filled"
                                                       Color="Color.Secondary"
                                                       StartIcon="@Icons.Material.Filled.PlayArrow">
                                                @pass.PassName
                                            </MudButton>
                                        }
                                    </div>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        }
    </div>
}
