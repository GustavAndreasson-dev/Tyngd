@page "/TP/dag2"
@layout MainLayout

<PageTitle>Dag 1</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Split</MudText>

<MudCarousel Class="mud-width-full" Style="height:200px;" ShowArrows="true" ShowBullets="false" EnableSwipeGesture="true" AutoCycle="false" TData="object">
    <MudCarouselItem Transition="transition" Color="@Color.Tertiary">
        <div class="d-flex flex-column justify-start align-center" style="height:100%">
            <MudText Typo="Typo.h5" Class="mb-2"> Marklyft</MudText>
            <MudText Typo="Typo.h6" Class="mb-2"> 4x5</MudText>
            <MudNumericField T="int?" Label="vikt" HideSpinButtons="true" Variant="Variant.Filled" Min="0" Max="400" Adornment="Adornment.End" AdornmentText="kg" @bind-Value="weights.Marklyft" OnBlur="OnWeightChanged" />
        </div>
    </MudCarouselItem>
    <MudCarouselItem Transition="transition" Color="@Color.Tertiary">
        <div class="d-flex flex-column justify-start align-center" style="height:100%">
            <MudText Typo="Typo.h5" Class="mb-2"> Stångrodd</MudText>
            <MudText Typo="Typo.h6" Class="mb-2"> 4x6-8</MudText>
            <MudNumericField T="int?" Label="vikt" HideSpinButtons="true" Variant="Variant.Filled" Min="0" Max="400" Adornment="Adornment.End" AdornmentText="kg" @bind-Value="weights.Stangrodd" OnBlur="OnWeightChanged" />
        </div>
    </MudCarouselItem>
    <MudCarouselItem Transition="transition" Color="@Color.Tertiary">
        <div class="d-flex flex-column justify-start align-center" style="height:100%">
            <MudText Typo="Typo.h5" Class="mb-2"> Latsdrag</MudText>
            <MudText Typo="Typo.h6" Class="mb-2"> 3x10-12</MudText>
            <MudNumericField T="int?" Label="vikt" HideSpinButtons="true" Variant="Variant.Filled" Min="0" Max="400" Adornment="Adornment.End" AdornmentText="kg" @bind-Value="weights.Latsdrag" OnBlur="OnWeightChanged" />
        </div>
    </MudCarouselItem>
    <MudCarouselItem Transition="transition" Color="@Color.Tertiary">
        <div class="d-flex flex-column justify-start align-center" style="height:100%">
            <MudText Typo="Typo.h5" Class="mb-2"> Stångcurl</MudText>
            <MudText Typo="Typo.h6" Class="mb-2"> 4x10-12</MudText>
            <MudNumericField T="int?" Label="vikt" HideSpinButtons="true" Variant="Variant.Filled" Min="0" Max="400" Adornment="Adornment.End" AdornmentText="kg" @bind-Value="weights.Stangcurl" OnBlur="OnWeightChanged" />
        </div>
    </MudCarouselItem>
    <MudCarouselItem Transition="transition" Color="@Color.Tertiary">
        <div class="d-flex flex-column justify-start align-center" style="height:100%">
            <MudText Typo="Typo.h5" Class="mb-2"> Hammercurls</MudText>
            <MudText Typo="Typo.h6" Class="mb-2"> 4x10-12</MudText>
            <MudNumericField T="int?" Label="vikt" HideSpinButtons="true" Variant="Variant.Filled" Min="0" Max="400" Adornment="Adornment.End" AdornmentText="kg" @bind-Value="weights.Hammercurls" OnBlur="OnWeightChanged" />
        </div>
    </MudCarouselItem>
    <MudCarouselItem Transition="transition" Color="@Color.Tertiary">
        <div class="d-flex flex-column justify-start align-center" style="height:100%">
            <MudText Typo="Typo.h5" Class="mb-2"> Omvända flyes</MudText>
            <MudText Typo="Typo.h6" Class="mb-2"> 3x15</MudText>
            <MudNumericField T="int?" Label="vikt" HideSpinButtons="true" Variant="Variant.Filled" Min="0" Max="400" Adornment="Adornment.End" AdornmentText="kg" @bind-Value="weights.OmvandaFlyes" OnBlur="OnWeightChanged" />
        </div>
    </MudCarouselItem>
</MudCarousel>


