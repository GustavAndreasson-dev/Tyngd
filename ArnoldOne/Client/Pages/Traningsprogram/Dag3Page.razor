@page "/TP/dag3"
@layout MainLayout

<PageTitle>Dag 3</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Split</MudText>

<MudCarousel Class="mud-width-full" Style="height:200px;" ShowArrows="true" ShowBullets="false" EnableSwipeGesture="true" AutoCycle="false" TData="object">
    <MudCarouselItem Transition="transition" Color="@Color.Secondary">
        <div class="d-flex flex-column justify-start align-center" style="height:100%">
            <MudText Typo="Typo.h5" Class="mb-2"> Knäböj</MudText>
            <MudText Typo="Typo.h6" Class="mb-2"> 5x6-8</MudText>
            <MudNumericField T="decimal?" Label="vikt" HideSpinButtons="true" Variant="Variant.Filled" Min="0" Max="400" Adornment="Adornment.End" AdornmentText="kg" @bind-Value="weights.Knaeboj" OnBlur="OnWeightChanged" />
        </div>
    </MudCarouselItem>
    <MudCarouselItem Transition="transition" Color="@Color.Secondary">
        <div class="d-flex flex-column justify-start align-center" style="height:100%">
            <MudText Typo="Typo.h5" Class="mb-2"> Rumänska marklyft</MudText>
            <MudText Typo="Typo.h6" Class="mb-2"> 5x6-8</MudText>
            <MudNumericField T="decimal?" Label="vikt" HideSpinButtons="true" Variant="Variant.Filled" Min="0" Max="400" Adornment="Adornment.End" AdornmentText="kg" @bind-Value="weights.RumanstMarklyft" OnBlur="OnWeightChanged" />
        </div>
    </MudCarouselItem>
    <MudCarouselItem Transition="transition" Color="@Color.Secondary">
        <div class="d-flex flex-column justify-start align-center" style="height:100%">
            <MudText Typo="Typo.h5" Class="mb-2"> Lårcurl</MudText>
            <MudText Typo="Typo.h6" Class="mb-2"> 3x10</MudText>
            <MudNumericField T="decimal?" Label="vikt" HideSpinButtons="true" Variant="Variant.Filled" Min="0" Max="400" Adornment="Adornment.End" AdornmentText="kg" @bind-Value="weights.LarCurl" OnBlur="OnWeightChanged" />
        </div>
    </MudCarouselItem>
    <MudCarouselItem Transition="transition" Color="@Color.Secondary">
        <div class="d-flex flex-column justify-start align-center" style="height:100%">
            <MudText Typo="Typo.h5" Class="mb-2"> Benspark</MudText>
            <MudText Typo="Typo.h6" Class="mb-2"> 3x10</MudText>
            <MudNumericField T="decimal?" Label="vikt" HideSpinButtons="true" Variant="Variant.Filled" Min="0" Max="400" Adornment="Adornment.End" AdornmentText="kg" @bind-Value="weights.Benspark" OnBlur="OnWeightChanged" />
        </div>
    </MudCarouselItem>
    <MudCarouselItem Transition="transition" Color="@Color.Secondary">
        <div class="d-flex flex-column justify-start align-center" style="height:100%">
            <MudText Typo="Typo.h5" Class="mb-2"> Vadpress</MudText>
            <MudText Typo="Typo.h6" Class="mb-2"> 4x10-12</MudText>
            <MudNumericField T="decimal?" Label="vikt" HideSpinButtons="true" Variant="Variant.Filled" Min="0" Max="400" Adornment="Adornment.End" AdornmentText="kg" @bind-Value="weights.Vadpress" OnBlur="OnWeightChanged" />
        </div>
    </MudCarouselItem>
    <MudCarouselItem Transition="transition" Color="@Color.Secondary">
        <div class="d-flex flex-column justify-start align-center" style="height:100%">
            <MudText Typo="Typo.h5" Class="mb-2"> Crunches</MudText>
            <MudText Typo="Typo.h6" Class="mb-2"> 4x10-12</MudText>
            <MudNumericField T="decimal?" Label="vikt" HideSpinButtons="true" Variant="Variant.Filled" Min="0" Max="400" Adornment="Adornment.End" AdornmentText="kg" @bind-Value="weights.Crunches" OnBlur="OnWeightChanged" />
        </div>
    </MudCarouselItem>
</MudCarousel>
