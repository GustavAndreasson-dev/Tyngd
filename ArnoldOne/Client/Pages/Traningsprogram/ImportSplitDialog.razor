@using ArnoldOne.Shared.TrainingPrograms

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Välj split att importera</MudText>
    </TitleContent>
    <DialogContent>
        @if (MySplits.Count > 0)
        {
            <MudText Typo="Typo.subtitle1" Class="mb-2">Mina egna splits</MudText>
            @foreach (var split in MySplits)
            {
                var s = split;
                <MudButton Variant="Variant.Outlined"
                           FullWidth="true"
                           Class="mb-2"
                           OnClick="@(async () => await SelectMySplit(s))">
                    @s.SplitName
                </MudButton>
            }
            <MudDivider Class="my-4" />
        }
        <MudText Typo="Typo.subtitle1" Class="mb-2">Splitmallar</MudText>
        @foreach (var template in Templates)
        {
            var t = template;
            <MudButton Variant="Variant.Outlined"
                       FullWidth="true"
                       Class="mb-2"
                       OnClick="@(async () => await SelectTemplate(t))">
                @t.SplitName
            </MudButton>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Avbryt</MudButton>
    </DialogActions>
</MudDialog>
