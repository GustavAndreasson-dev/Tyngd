@page "/TP/split/{SplitId:int}/pass/{PassId:int}"
@layout MainLayout
@inherits PageComponentBase

<PageTitle>@pass?.PassName</PageTitle>

<ErrorAlert Message="@ErrorMessage" OnClose="ClearError" />

@if (!string.IsNullOrWhiteSpace(saveStatusMessage))
{
    <MudAlert Severity="@saveStatusSeverity" Dense="true" ShowCloseIcon="true" CloseIconClicked="ClearSaveStatus" Class="mb-4">
        @saveStatusMessage
    </MudAlert>
}

<MudText Typo="Typo.h4" Class="mb-4">@pass?.PassName</MudText>

@if (pass is not null)
{
    <div class="pass-layout">
    <div class="pass-content">
    <MudCarousel Class="mud-width-full" Style="height:400px; overflow-y:auto;" ShowArrows="true" ShowBullets="false" EnableSwipeGesture="false" AutoCycle="false" TData="object" SelectedIndex="@activeIndex" SelectedIndexChanged="OnCarouselIndexChanged">
        @foreach (var exercise in pass.Exercises)
        {
            <MudCarouselItem Transition="transition" Color="@Color.Secondary">
                <div class="d-flex flex-column justify-start align-center" style="min-height:100%; gap:8px;">
                    <MudText Typo="Typo.h5" Class="mb-2">@exercise.Exercise.ExerciseName</MudText>
                    <MudText Typo="Typo.h6" Class="mb-2">@FormatSetsReps(exercise)</MudText>
                    <MudNumericField T="decimal?" Label="vikt" HideSpinButtons="true" Variant="Variant.Filled" Min="0" Max="400" Adornment="Adornment.End" AdornmentText="kg" Value="GetWeight(exercise.ExerciseId)" ValueChanged="v => SetWeight(exercise.ExerciseId, v)" OnBlur="OnWeightChanged" Class="weight-field" />
                </div>
            </MudCarouselItem>
        }
    </MudCarousel>

    @if (activeIndex >= 0 && activeIndex < pass!.Exercises.Count)
    {
        var exercise = pass.Exercises[activeIndex];
        <div class="slider-wrapper" style="margin-top:16px;">
            @for (int s = 0; s < exercise.DefaultSets; s++)
            {
                var setIndex = s;
                var currentExercise = exercise;
                <div class="d-flex align-center" style="margin-bottom:8px; gap:8px;">
                    <div class="d-flex align-center justify-space-between" style="width:75%; gap:8px;">
                        <MudText Style="min-width:48px;">Set @(setIndex + 1)</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" OnClick="() => AdjustReps(currentExercise.ExerciseId, setIndex, -1)" />
                        <MudText Style="min-width:32px; text-align:center;">@((int)GetReps(currentExercise.ExerciseId, setIndex))</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="() => AdjustReps(currentExercise.ExerciseId, setIndex, 1)" />
                        <MudText Style="min-width:32px;">reps</MudText>
                    </div>
                    <div style="width:25%; display:flex; justify-content:center;">
                        <MudIconButton Icon="@(IsSetDone(currentExercise.ExerciseId, setIndex) ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)"
                                       Size="Size.Medium"
                                       Color="@(IsSetDone(currentExercise.ExerciseId, setIndex) ? Color.Success : Color.Default)"
                                       OnClick="() => ToggleSet(currentExercise.ExerciseId, setIndex)" />
                    </div>
                </div>
            }
        </div>
        <MudTextField T="string"
                      Label="Anteckningar"
                      Lines="3"
                      Variant="Variant.Outlined"
                      Value="@GetNote(exercise.ExerciseId)"
                      ValueChanged="v => SetNote(exercise.ExerciseId, v)"
                      OnBlur="OnNoteChanged"
                      Class="mt-4 note-field" />
    }
    </div>
    <div class="@NavClass">
        <MudText Typo="Typo.subtitle2" Class="mb-3 px-1">Övningar</MudText>
        @for (int i = 0; i < pass.Exercises.Count; i++)
        {
            var idx = i;
            var ex = pass.Exercises[i];
            <div class="@StepClass(idx)" @onclick="() => NavigateToExercise(idx)">
                <div class="pass-step-circle">@(idx + 1)</div>
                <MudText Class="pass-step-label" Typo="Typo.body2">@ex.Exercise.ExerciseName</MudText>
            </div>
        }
    </div>
    </div>
    <div class="pass-nav-toggle">
        <MudFab Color="Color.Secondary"
                StartIcon="@(_navOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.List)"
                Size="Size.Small" OnClick="ToggleNav" />
    </div>
    @if (AllSetsDone())
    {
        <div class="d-flex justify-center mt-6 mb-4">
            <MudButton Variant="Variant.Filled" Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.CheckCircle"
                       Size="Size.Large" OnClick="EndPass">Avsluta pass</MudButton>
        </div>
    }
}
else
{
    <MudText>Passet hittades inte.</MudText>
}
