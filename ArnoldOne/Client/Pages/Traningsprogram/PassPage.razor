@page "/TP/pass/{PassId:int}"
@layout MainLayout
@using ArnoldOne.Shared.TrainingPrograms

<PageTitle>@pass?.PassName</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@pass?.PassName</MudText>

@if (pass is not null)
{
    <div class="pass-layout">
    <div class="pass-content">
    <MudCarousel Class="mud-width-full" Style="height:400px; overflow-y:auto;" ShowArrows="true" ShowBullets="false" EnableSwipeGesture="true" AutoCycle="false" TData="object" @bind-SelectedIndex="activeIndex">
        @foreach (var exercise in pass.Exercises)
        {
            <MudCarouselItem Transition="transition" Color="@Color.Secondary">
                <div class="d-flex flex-column justify-start align-center" style="min-height:100%; gap:8px;">
                    <MudText Typo="Typo.h5" Class="mb-2">@exercise.ExerciseName</MudText>
                    <MudText Typo="Typo.h6" Class="mb-2">@FormatSetsReps(exercise)</MudText>
                    <MudNumericField T="decimal?" Label="vikt" HideSpinButtons="true" Variant="Variant.Filled" Min="0" Max="400" Adornment="Adornment.End" AdornmentText="kg" Value="GetWeight(exercise.ExerciseId)" ValueChanged="v => SetWeight(exercise.ExerciseId, v)" OnBlur="OnWeightChanged" Class="weight-field" />
                </div>
            </MudCarouselItem>
        }
    </MudCarousel>

    @if (activeIndex >= 0 && activeIndex < pass.Exercises.Count)
    {
        var exercise = pass.Exercises[activeIndex];
        <div class="slider-wrapper" style="margin-top:16px;">
            @for (int s = 0; s < exercise.DefaultSets; s++)
            {
                var setIndex = s;
                <div class="d-flex align-center justify-space-between" style="gap:8px; margin-bottom:8px;">
                    <MudText Style="min-width:48px;">Set @(setIndex + 1)</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" OnClick="() => AdjustReps(exercise.ExerciseId, setIndex, -1)" />
                    <MudText Style="min-width:32px; text-align:center;">@((int)GetReps(exercise.ExerciseId, setIndex))</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="() => AdjustReps(exercise.ExerciseId, setIndex, 1)" />
                    <MudText Style="min-width:32px;">reps</MudText>
                </div>
            }
        </div>
        <MudTextField T="string"
                      Label="Anteckningar"
                      Lines="3"
                      Variant="Variant.Outlined"
                      Value="@GetNote(exercise.ExerciseId)"
                      ValueChanged="v => SetNote(exercise.ExerciseId, v)"
                      OnBlur="OnNoteChanged"
                      Class="mt-4 note-field" />
    }
    </div>
    <div class="@NavClass">
        <MudText Typo="Typo.subtitle2" Class="mb-3 px-1">Övningar</MudText>
        @for (int i = 0; i < pass.Exercises.Count; i++)
        {
            var idx = i;
            var ex = pass.Exercises[i];
            <div class="@StepClass(idx)" @onclick="() => NavigateToExercise(idx)">
                <div class="pass-step-circle">@(idx + 1)</div>
                <MudText Class="pass-step-label" Typo="Typo.body2">@ex.ExerciseName</MudText>
            </div>
        }
    </div>
    </div>
    <div class="pass-nav-toggle">
        <MudFab Color="Color.Secondary"
                StartIcon="@(_navOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.List)"
                Size="Size.Small" OnClick="ToggleNav" />
    </div>
}
else
{
    <MudText>Passet hittades inte.</MudText>
}
