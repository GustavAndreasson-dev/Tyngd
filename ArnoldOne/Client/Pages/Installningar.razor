@page "/installningar"
@namespace ArnoldOne.Client.Pages

<PageTitle>Inställningar</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6 pt-2">Inställningar</MudText>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <MudAlert Severity="Severity.Success" Dense="true" ShowCloseIcon="true" CloseIconClicked="ClearSuccess" Class="mb-4">
        @successMessage
    </MudAlert>
}

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <label class="ui-switch">
        Mörkt läge
        <input type="checkbox" role="switch" checked="@ThemeState.IsDarkMode" @onchange="e => OnDarkModeChanged((bool)e.Value!)" />
        <span class="ui-switch__track"></span>
    </label>
</MudPaper>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.subtitle1" Class="mb-3">Vilotimer</MudText>
    <label class="ui-switch">
        Aktivera vilotimer
        <input type="checkbox" role="switch" checked="@RestTimer.IsEnabled" @onchange="e => OnRestTimerEnabledChanged((bool)e.Value!)" />
        <span class="ui-switch__track"></span>
    </label>
    <MudNumericField T="int"
                     Label="Vilotid (minuter)"
                     Value="@_restTimerMinutes"
                     ValueChanged="OnRestTimerMinutesChanged"
                     Min="1" Max="10"
                     Disabled="@(!RestTimer.IsEnabled)"
                     Variant="Variant.Filled"
                     Class="mt-2"
                     Style="max-width:180px;" />
    @switch (_notificationPermission)
    {
        case "default":
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.NotificationsActive"
                       Class="mt-3" OnClick="RequestNotificationPermission">
                Visa notis när vilan är slut
            </MudButton>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                Då får du en notis om appen ligger i bakgrunden när vilan tar slut.
            </MudText>
            break;
        case "granted":
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-3">
                Notis visas när vilan är slut och appen ligger i bakgrunden.
            </MudText>
            break;
        case "denied":
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-3">
                Notiser är blockerade för Arnold. Tillåt dem i webbläsarens inställningar för att få en notis när vilan är slut.
            </MudText>
            break;
    }
</MudPaper>

@if (PwaService.CanInstall)
{
    <MudPaper Class="pa-4" Elevation="2">
        <MudText Typo="Typo.subtitle1" Class="mb-3">App</MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.InstallMobile"
                   OnClick="InstallArnold">
            Installera Arnold
        </MudButton>
    </MudPaper>
}

