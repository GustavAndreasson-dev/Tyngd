@namespace ArnoldOne.Shared
<MudNavLink Href="" Icon="@Icons.Material.Filled.Backup">Översikt</MudNavLink>
@foreach (var template in activeSplitTemplates)
{
    <MudNavGroup Title="@template.SplitName" Expanded="true" Icon="@Icons.Material.Filled.AdsClick">
        @foreach (var pass in template.Passes)
        {
            <MudNavLink Href="@($"TP/split/{template.SplitId}/pass/{pass.PassId}")" Icon="@Icons.Material.Filled.Backup">@pass.PassName</MudNavLink>
        }
    </MudNavGroup>
}
