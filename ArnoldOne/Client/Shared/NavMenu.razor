@namespace ArnoldOne.Shared
<MudNavLink Href="" Icon="@Icons.Material.Filled.Backup">Översikt</MudNavLink>
<MudNavGroup Title="@ppl1Template.SplitName" Expanded="true" Icon="@Icons.Material.Filled.AdsClick">
    @foreach (var pass in ppl1Template.Passes)
    {
        <MudNavLink Href="@($"TP/pass/{pass.PassId}")" Icon="@Icons.Material.Filled.Backup">@pass.PassName</MudNavLink>
    }
</MudNavGroup>

<MudNavGroup Title="@pplTemplate.SplitName" Expanded="true" Icon="@Icons.Material.Filled.AdsClick">
    @foreach (var pass in pplTemplate.Passes)
    {
        <MudNavLink Href="@($"TP/pass/{pass.PassId}")" Icon="@Icons.Material.Filled.Backup">@pass.PassName</MudNavLink>
    }
</MudNavGroup>
