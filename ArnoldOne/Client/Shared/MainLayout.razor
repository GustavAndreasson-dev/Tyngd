@namespace ArnoldOne.Shared
@using ArnoldOne.Client.Services
@using ArnoldOne.Client.Shared
@inherits LayoutComponentBase
<MudThemeProvider Theme="@_theme" IsDarkMode="@ThemeState.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<PageTitle>ArnoldOne</PageTitle>
<MudLayout>
    <MudAppBar Elevation="0">
        <MudIconButton Class="app-menu-toggle" Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h6" Class="ml-3 app-wordmark">Arnold</MudText>
        <MudSpacer />
        <RestPill />
        @if (PendingSync.HasVisiblePendingSync)
        {
            <MudButton Class="pending-sync-badge"
                       Variant="Variant.Filled"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.SyncProblem"
                       Disabled="@_syncingPendingData"
                       OnClick="SyncPendingData">
                Osynkat
            </MudButton>
        }
        <MudMenu @ref="_menu"
                 Icon="@Icons.Material.Filled.MoreVert"
                 Color="Color.Inherit"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight">
            @if (LoginState.IsLoggedIn)
            {
                <MudMenuItem Disabled="true" Icon="@Icons.Material.Filled.AccountCircle">@LoginState.CurrentUser!.UserName</MudMenuItem>
                <MudDivider />
                @if (LoginState.CurrentUser!.IsAdmin)
                {
                    <MudMenuItem Href="/admin" Icon="@Icons.Material.Filled.AdminPanelSettings">Admin</MudMenuItem>
                    <MudDivider />
                }
                <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout">Logga ut</MudMenuItem>
                <MudDivider />
            }
            else
            {
                <MudMenuItem Icon="@Icons.Material.Filled.Login" OnClick="OpenLoginDialog">Logga in</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.PersonAdd" OnClick="OpenRegisterDialog">Skapa konto</MudMenuItem>
                <MudDivider />
            }
            <MudMenuItem Href="/installningar" Icon="@Icons.Material.Filled.Settings">Inställningar</MudMenuItem>
        </MudMenu>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0">
         <MudNavMenu>
             <NavMenu />
          </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        @if (_ready)
        {
            @Body
        }
    </MudMainContent>
    <BottomNav />
</MudLayout>

@code {
    // Palette: 381D2A aubergine, FAF9F9 off-white, FFD6BA peach, 23CE6B green, E3B23C gold. Other shades are mixes of these.
    private MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#381D2A", PrimaryContrastText = "#FAF9F9",
            Secondary = "#E3B23C", SecondaryContrastText = "#381D2A",
            Tertiary = "#FFD6BA", TertiaryContrastText = "#381D2A",
            Success = "#23CE6B", SuccessContrastText = "#381D2A",
            Warning = "#E3B23C", WarningContrastText = "#381D2A",
            Background = "#F2F0F1", BackgroundGray = "#EEECED", Surface = "#FAF9F9",
            AppbarBackground = "#FAF9F9", AppbarText = "#381D2A",
            DrawerBackground = "#FAF9F9", DrawerText = "#381D2A",
            TextPrimary = "#381D2A", TextSecondary = "#7C6A73", TextDisabled = "#A99BA2",
            ActionDefault = "#381D2A", LinesDefault = "#E7E3E4", LinesInputs = "#C9C0C4", Divider = "#E7E3E4",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#FFD6BA", PrimaryContrastText = "#381D2A",
            Secondary = "#E3B23C", SecondaryContrastText = "#381D2A",
            Tertiary = "#23CE6B", TertiaryContrastText = "#381D2A",
            Success = "#23CE6B", SuccessContrastText = "#381D2A",
            Warning = "#E3B23C", WarningContrastText = "#381D2A",
            Background = "#1F1017", BackgroundGray = "#45303A", Surface = "#381D2A",
            AppbarBackground = "#381D2A", AppbarText = "#FAF9F9",
            DrawerBackground = "#381D2A", DrawerText = "#FAF9F9",
            TextPrimary = "#FAF9F9", TextSecondary = "#C0B7BB", TextDisabled = "#8F7F87",
            ActionDefault = "#FAF9F9", LinesDefault = "#573F4B", LinesInputs = "#7A6470", Divider = "#573F4B",
        }
    };
}
