@namespace ArnoldOne.Shared
@using ArnoldOne.Client.Services
@using ArnoldOne.Client.Shared
@inherits LayoutComponentBase
<MudThemeProvider Theme="@_theme" IsDarkMode="@ThemeState.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<PageTitle>ArnoldOne</PageTitle>
<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h5" Class="ml-3">Arnold</MudText>
        <MudSpacer />
        @if (PendingSync.HasVisiblePendingSync)
        {
            <MudButton Class="pending-sync-badge"
                       Variant="Variant.Filled"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.SyncProblem"
                       Disabled="@_syncingPendingData"
                       OnClick="SyncPendingData">
                Osynkat
            </MudButton>
        }
        <MudMenu @ref="_menu" Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End">
            @if (LoginState.IsLoggedIn)
            {
                <MudMenuItem Disabled="true" Icon="@Icons.Material.Filled.AccountCircle">@LoginState.CurrentUser!.UserName</MudMenuItem>
                <MudDivider />
                @if (LoginState.CurrentUser!.IsAdmin)
                {
                    <MudMenuItem Href="/admin" Icon="@Icons.Material.Filled.AdminPanelSettings">Admin</MudMenuItem>
                    <MudDivider />
                }
                <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout">Logga ut</MudMenuItem>
                <MudDivider />
            }
            else
            {
                <MudMenuItem Icon="@Icons.Material.Filled.Login" OnClick="OpenLoginDialog">Logga in</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.PersonAdd" OnClick="OpenRegisterDialog">Skapa konto</MudMenuItem>
                <MudDivider />
            }
            <MudMenuItem Href="/installningar" Icon="@Icons.Material.Filled.Settings">Inställningar</MudMenuItem>
        </MudMenu>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
         <MudNavMenu>
             <NavMenu />
          </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        @if (_ready)
        {
            @Body
        }
    </MudMainContent>
</MudLayout>

@code {
    private MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Secondary = "#7B1F3A",
            Tertiary  = "#C4933F",
        },
        PaletteDark = new PaletteDark
        {
            Secondary = "#A0294E",
            Tertiary  = "#D4A84B"
        }
    };
}
