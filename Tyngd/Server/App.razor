<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=4.0, viewport-fit=cover" />
    <title>Tyngd</title>
    <base href="/" />
    <script>
        // Paint the saved theme's background before Blazor boots, so a dark-mode reload never flashes white.
        (function () {
            var d = null;
            try { d = localStorage.getItem('tyngd-dark'); } catch (e) { }
            var dark = window.tyngdBootDark = d === null ? matchMedia('(prefers-color-scheme: dark)').matches : d === '1';
            document.documentElement.style.background = dark ? '#040F0F' : '#ECFEFF';
        })();
    </script>
    <meta name="theme-color" content="#F8FFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0F1D1E" media="(prefers-color-scheme: dark)" />
    <link href="@Assets["css/app.css"]" rel="stylesheet" />
    <link href="@Assets["Tyngd.Server.styles.css"]" rel="stylesheet" />
    <link href="manifest.json" rel="manifest" />
    <link rel="icon" type="image/x-icon" href="@Assets["favicon.ico"]" />
    <link rel="apple-touch-icon" sizes="180x180" href="@Assets["icons/tyngd-apple-touch-180.png"]" />
    <link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet" />
    <HeadOutlet @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
</head>

<body>
    <Routes @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">??</a>
    </div>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["js/utils.js"]"></script>
    <script src="@Assets["js/pwa.js"]"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
