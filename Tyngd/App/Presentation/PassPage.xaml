<Page x:Class="Tyngd.App.Presentation.PassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:controls="using:Tyngd.App.Presentation.Controls"
      Background="{ThemeResource BackgroundBrush}"
      Loaded="OnLoaded"
      Unloaded="OnUnloaded">
  <!-- Passet i helskärm utan bottenmeny, som /pass/ i webbappen. -->
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Sidhuvud -->
    <Grid Padding="4,8,16,8"
          ColumnSpacing="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Style="{StaticResource TextButtonStyle}"
              Command="{Binding GoBackCommand}"
              MinWidth="48"
              MinHeight="48"
              AutomationProperties.Name="Tillbaka">
        <PathIcon Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" />
      </Button>
      <StackPanel Grid.Column="1"
                  VerticalAlignment="Center">
        <TextBlock Text="{Binding ExerciseLabel}"
                   Style="{StaticResource LabelMedium}"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                   Visibility="{Binding IsLoaded}" />
        <TextBlock Text="{Binding PassName}"
                   Style="{StaticResource TitleLarge}"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="2"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Right">
        <TextBlock Text="{Binding SetsSummary}"
                   Style="{StaticResource BodyMedium}"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                   HorizontalAlignment="Right" />
        <Button Content="Muskler"
                Style="{StaticResource TextButtonStyle}"
                Command="{Binding ToggleMusclesCommand}"
                Visibility="{Binding IsLoaded}"
                HorizontalAlignment="Right"
                MinHeight="40" />
      </StackPanel>
    </Grid>

    <!-- Fel och sparstatus -->
    <StackPanel Grid.Row="1"
                Padding="16,0"
                Spacing="8">
      <ProgressBar Value="{Binding ProgressPercent}"
                   Maximum="100"
                   Visibility="{Binding IsLoaded}" />
      <InfoBar Severity="Error"
               Message="{Binding ErrorMessage}"
               IsOpen="{Binding HasError}"
               IsClosable="False" />
      <InfoBar Severity="{Binding StatusSeverity}"
               Message="{Binding StatusMessage}"
               IsOpen="{Binding IsStatusOpen, Mode=TwoWay}"
               AutomationProperties.LiveSetting="Polite" />
    </StackPanel>

    <ProgressRing Grid.Row="2"
                  IsActive="{Binding IsLoading}"
                  Visibility="{Binding IsLoading}"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center" />
    <TextBlock Grid.Row="2"
               Text="Passet hittades inte."
               Style="{StaticResource BodyLarge}"
               Margin="16"
               Visibility="{Binding NotFound}" />

    <ScrollViewer Grid.Row="2"
                  Visibility="{Binding IsLoaded}">
      <StackPanel Padding="16,8,16,16"
                  Spacing="16">

        <Border Background="{ThemeResource SurfaceBrush}"
                CornerRadius="12"
                Padding="16"
                Visibility="{Binding ShowMuscles}"
                AutomationProperties.Name="Muskler i passet">
          <Grid>
            <ProgressBar IsIndeterminate="True"
                         Visibility="{Binding IsLoadingMuscles}" />
            <controls:MuscleMap x:Name="PassMuscleMap"
                                MuscleLoad="{Binding MuscleLoad}" />
          </Grid>
        </Border>

        <!-- Övningar -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Enabled"
                      VerticalScrollMode="Disabled">
          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <ItemsControl ItemsSource="{Binding Chips}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"
                              Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Button Style="{StaticResource FilledTonalButtonStyle}"
                            Command="{Binding SelectCommand}"
                            Visibility="{Binding IsActive}"
                            MinHeight="48">
                      <StackPanel Orientation="Horizontal"
                                  Spacing="6">
                        <PathIcon Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                  Visibility="{Binding IsDone}" />
                        <TextBlock Text="{Binding Label}" />
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OutlinedButtonStyle}"
                            Command="{Binding SelectCommand}"
                            Visibility="{Binding IsInactive}"
                            MinHeight="48">
                      <StackPanel Orientation="Horizontal"
                                  Spacing="6">
                        <PathIcon Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                  Visibility="{Binding IsDone}" />
                        <TextBlock Text="{Binding Label}" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="+ Övning"
                    Style="{StaticResource OutlinedButtonStyle}"
                    MinHeight="48"
                    Visibility="{Binding IsFreeSession}"
                    IsEnabled="{Binding CanAddExercise}"
                    Click="OnAddExerciseClick" />
          </StackPanel>
        </ScrollViewer>

        <!-- Aktiv övning -->
        <Border Background="{ThemeResource SurfaceBrush}"
                CornerRadius="12"
                Padding="16"
                Visibility="{Binding HasActive}">
          <StackPanel Spacing="16">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal"
                            Spacing="2">
                  <TextBlock Text="{Binding ExerciseName}"
                             Style="{StaticResource TitleLarge}"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                  <Button Style="{StaticResource TextButtonStyle}"
                          Command="{Binding ShowExerciseInfoCommand}"
                          Visibility="{Binding HasCatalogInfo}"
                          MinWidth="48"
                          MinHeight="48"
                          Padding="8"
                          AutomationProperties.Name="Om övningen">
                    <PathIcon Data="M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" />
                  </Button>
                </StackPanel>
                <TextBlock Text="{Binding SetsReps}"
                           Style="{StaticResource BodyMedium}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}" />
              </StackPanel>
              <NumberBox Grid.Column="1"
                         Header="Vikt (kg)"
                         Value="{Binding Weight, Mode=TwoWay}"
                         Minimum="0"
                         Maximum="400"
                         SpinButtonPlacementMode="Hidden"
                         ValidationMode="InvalidInputOverwritten"
                         InputScope="Number"
                         Width="120"
                         VerticalAlignment="Top"
                         AutomationProperties.Name="Vikt i kilo" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Sets}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid CornerRadius="14">
                    <Border Background="{ThemeResource SurfaceVariantBrush}" />
                    <Border Background="{ThemeResource PrimaryContainerBrush}"
                            Visibility="{Binding IsDone}" />
                    <Grid Padding="16,6,6,6"
                          ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Label}"
                                 Style="{StaticResource TitleSmall}"
                                 VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Center"
                                  Spacing="8">
                        <Button Style="{StaticResource OutlinedButtonStyle}"
                                Command="{Binding DecreaseCommand}"
                                Width="48"
                                Height="48"
                                Padding="0"
                                AutomationProperties.Name="Minska reps">
                          <PathIcon Data="M19 13H5v-2h14v2z" />
                        </Button>
                        <StackPanel MinWidth="48"
                                    VerticalAlignment="Center">
                          <TextBlock Text="{Binding Reps}"
                                     Style="{StaticResource HeadlineSmall}"
                                     HorizontalAlignment="Center" />
                          <TextBlock Text="reps"
                                     Style="{StaticResource LabelMedium}"
                                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                     HorizontalAlignment="Center" />
                        </StackPanel>
                        <Button Style="{StaticResource OutlinedButtonStyle}"
                                Command="{Binding IncreaseCommand}"
                                Width="48"
                                Height="48"
                                Padding="0"
                                AutomationProperties.Name="Öka reps">
                          <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                        </Button>
                      </StackPanel>
                      <Grid Grid.Column="2">
                        <Button Command="{Binding ToggleCommand}"
                                Visibility="{Binding IsDone}"
                                Width="56"
                                Height="56"
                                Padding="0"
                                AutomationProperties.Name="Ångra set klart">
                          <PathIcon Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                        </Button>
                        <Button Style="{StaticResource OutlinedButtonStyle}"
                                Command="{Binding ToggleCommand}"
                                Visibility="{Binding IsNotDone}"
                                Width="56"
                                Height="56"
                                Padding="0"
                                AutomationProperties.Name="Markera set klart">
                          <PathIcon Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                    Foreground="{ThemeResource OutlineBrush}" />
                        </Button>
                      </Grid>
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Sparas vid varje tecken, så att inget försvinner om appen stängs mitt i. -->
            <TextBox Header="Anteckningar"
                     Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="72" />

            <Border BorderBrush="{ThemeResource OutlineVariantBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,14"
                    Visibility="{Binding HasProgress}">
              <StackPanel Spacing="8">
                <Grid>
                  <TextBlock Text="Viktutveckling"
                             Style="{StaticResource LabelLarge}" />
                  <TextBlock Text="{Binding ProgressSummary}"
                             Style="{StaticResource BodyMedium}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             HorizontalAlignment="Right" />
                </Grid>
                <Viewbox Stretch="Uniform"
                         AutomationProperties.Name="Viktutveckling de senaste passen">
                  <Canvas Width="300"
                          Height="80">
                    <Polyline Points="{Binding ProgressPoints}"
                              Stroke="{ThemeResource PrimaryBrush}"
                              StrokeThickness="2.5"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                  </Canvas>
                </Viewbox>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Vilotimer -->
    <Border Grid.Row="3"
            Margin="16,0,16,8"
            Padding="16,12"
            CornerRadius="16"
            Background="{ThemeResource PrimaryBrush}"
            Visibility="{Binding IsResting}"
            AutomationProperties.Name="Vilotimer">
      <StackPanel Spacing="4">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Vila"
                     Style="{StaticResource LabelLarge}"
                     Foreground="{ThemeResource OnPrimaryBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="{Binding RestTime}"
                     Style="{StaticResource HeadlineMedium}"
                     Foreground="{ThemeResource OnPrimaryBrush}"
                     HorizontalAlignment="Center" />
          <Button Grid.Column="2"
                  Content="Hoppa över"
                  Style="{StaticResource TextButtonStyle}"
                  Foreground="{ThemeResource OnPrimaryBrush}"
                  Command="{Binding CancelRestCommand}"
                  MinHeight="48" />
        </Grid>
        <ProgressBar Value="{Binding RestPercent}"
                     Maximum="100"
                     Foreground="{ThemeResource OnPrimaryBrush}" />
      </StackPanel>
    </Border>

    <!-- Bottenrad: föregående / avsluta / nästa -->
    <Border Grid.Row="4"
            Background="{ThemeResource SurfaceBrush}"
            BorderBrush="{ThemeResource OutlineVariantBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,12"
            Visibility="{Binding IsLoaded}">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource FilledTonalButtonStyle}"
                Command="{Binding PreviousCommand}"
                MinWidth="56"
                MinHeight="48"
                AutomationProperties.Name="Föregående övning">
          <PathIcon Data="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" />
        </Button>
        <TextBlock Grid.Column="1"
                   Text="{Binding DoneText}"
                   Style="{StaticResource BodyMedium}"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding IsNotAllDone}" />
        <Button x:Name="EndPassButton"
                Grid.Column="1"
                Content="Avsluta pass"
                HorizontalAlignment="Stretch"
                MinHeight="48"
                Visibility="{Binding AllDone}"
                Click="OnEndPassClick" />
        <Button Grid.Column="2"
                Style="{StaticResource FilledTonalButtonStyle}"
                Command="{Binding NextCommand}"
                MinWidth="56"
                MinHeight="48"
                AutomationProperties.Name="Nästa övning">
          <PathIcon Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</Page>
