<UserControl x:Class="Tyngd.App.Presentation.Controls.ExercisePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Väljer övning ur katalogen. Fritext som inte matchar katalogen blir en egen övning. -->
  <StackPanel Spacing="4">
    <AutoSuggestBox x:Name="Box"
                    Header="Övning"
                    PlaceholderText="Sök på svenska eller engelska"
                    TextMemberPath="Name"
                    TextChanged="OnTextChanged"
                    SuggestionChosen="OnSuggestionChosen"
                    GotFocus="OnGotFocus">
      <AutoSuggestBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Padding="0,4">
            <TextBlock Text="{Binding Title}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Subtitle}"
                       Style="{StaticResource BodySmall}"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </AutoSuggestBox.ItemTemplate>
    </AutoSuggestBox>
    <TextBlock x:Name="ErrorLabel"
               Foreground="{ThemeResource ErrorBrush}"
               Style="{StaticResource BodySmall}"
               TextWrapping="Wrap"
               Visibility="Collapsed" />
    <TextBlock x:Name="CustomLabel"
               Text="Egen övning (finns inte i katalogen)"
               Foreground="{ThemeResource OnSurfaceVariantBrush}"
               Style="{StaticResource BodySmall}"
               Visibility="Collapsed" />
    <TextBlock x:Name="HelperLabel"
               Foreground="{ThemeResource OnSurfaceVariantBrush}"
               Style="{StaticResource BodySmall}"
               TextWrapping="Wrap"
               Visibility="Collapsed" />
  </StackPanel>
</UserControl>
