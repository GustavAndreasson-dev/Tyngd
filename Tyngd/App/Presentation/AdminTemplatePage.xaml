<Page x:Class="Tyngd.App.Presentation.AdminTemplatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:controls="using:Tyngd.App.Presentation.Controls"
      Background="{ThemeResource BackgroundBrush}">
  <Page.Resources>
    <Style x:Key="IconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource TextButtonStyle}">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </Page.Resources>

  <Grid utu:SafeArea.Insets="VisibleBounds,SoftInput">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Helskärmssida: egen tillbakaknapp som avbryter utan att spara. -->
    <Grid Padding="4,8,16,8"
          ColumnSpacing="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Style="{StaticResource IconButtonStyle}"
              Command="{Binding CancelCommand}"
              AutomationProperties.Name="Till admin">
        <PathIcon Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" />
      </Button>
      <TextBlock Grid.Column="1"
                 Text="{Binding Title}"
                 Style="{StaticResource HeadlineSmall}"
                 VerticalAlignment="Center" />
    </Grid>

    <ScrollViewer Grid.Row="1">
      <StackPanel Padding="16,0,16,24"
                  Spacing="16">
        <TextBlock Text="Befintliga id:n behålls. Borttagna delar arkiveras när du sparar."
                   Style="{StaticResource BodyMedium}"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                   TextWrapping="Wrap" />
        <ProgressBar IsIndeterminate="True"
                     Visibility="{Binding IsLoading}" />
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{ThemeResource ErrorBrush}"
                   TextWrapping="Wrap" />

        <Border Background="{ThemeResource SurfaceBrush}"
                CornerRadius="12"
                Padding="16">
          <StackPanel Spacing="8">
            <TextBox Header="Mallnamn"
                     Text="{Binding TemplateName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="50" />
            <!-- Material-stilen visar varken Header eller On/OffContent ordentligt; egen etikett. -->
            <StackPanel Orientation="Horizontal"
                        Spacing="12">
              <TextBlock Text="Aktiv"
                         Style="{StaticResource BodyLarge}"
                         VerticalAlignment="Center" />
              <ToggleSwitch IsOn="{Binding IsVisible, Mode=TwoWay}"
                            OnContent=""
                            OffContent=""
                            AutomationProperties.Name="Mallen är aktiv" />
            </StackPanel>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Passes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{ThemeResource SurfaceBrush}"
                      BorderBrush="{ThemeResource PrimaryBrush}"
                      BorderThickness="4,0,0,0"
                      CornerRadius="12"
                      Padding="12"
                      Margin="0,0,0,16">
                <StackPanel Spacing="12">
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource TitleLarge}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                      <TextBlock Text="Aktiv"
                                 Style="{StaticResource BodyMedium}"
                                 VerticalAlignment="Center" />
                      <ToggleSwitch IsOn="{Binding IsVisible, Mode=TwoWay}"
                                    OnContent=""
                                    OffContent=""
                                    MinWidth="0"
                                    AutomationProperties.Name="Passet är aktivt" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Style="{StaticResource IconButtonStyle}"
                            Command="{Binding RemoveCommand}"
                            AutomationProperties.Name="Ta bort pass">
                      <PathIcon Data="M16 9v10H8V9h8m-1.5-6h-5l-1 1H5v2h14V4h-3.5l-1-1zM18 7H6v12c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7z"
                                Foreground="{ThemeResource ErrorBrush}" />
                    </Button>
                  </Grid>
                  <TextBox Header="Passnamn"
                           Text="{Binding PassName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           MaxLength="50" />

                  <ItemsControl ItemsSource="{Binding Exercises}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{ThemeResource SurfaceVariantBrush}"
                                BorderBrush="{ThemeResource OutlineVariantBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,0,0,12">
                          <StackPanel Spacing="8">
                            <controls:ExercisePicker ExerciseName="{Binding ExerciseName, Mode=TwoWay}"
                                                     CatalogExerciseId="{Binding CatalogExerciseId, Mode=TwoWay}" />
                            <Grid ColumnSpacing="8"
                                  RowSpacing="8">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                              </Grid.RowDefinitions>
                              <TextBox Header="Set"
                                       Text="{Binding SetsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       InputScope="Number" />
                              <TextBox Grid.Column="1"
                                       Header="Vikt (kg)"
                                       Text="{Binding WeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       InputScope="Number" />
                              <TextBox Grid.Row="1"
                                       Header="Reps min"
                                       Text="{Binding RepsMinText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       InputScope="Number" />
                              <TextBox Grid.Row="1"
                                       Grid.Column="1"
                                       Header="Reps max"
                                       Text="{Binding RepsMaxText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       InputScope="Number" />
                            </Grid>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <StackPanel Orientation="Horizontal"
                                          Spacing="8">
                                <TextBlock Text="Aktiv"
                                           Style="{StaticResource BodyMedium}"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch IsOn="{Binding IsVisible, Mode=TwoWay}"
                                              OnContent=""
                                              OffContent=""
                                              AutomationProperties.Name="Övningen är aktiv" />
                              </StackPanel>
                              <Button Grid.Column="1"
                                      Style="{StaticResource IconButtonStyle}"
                                      Command="{Binding RemoveCommand}"
                                      AutomationProperties.Name="Ta bort övning">
                                <PathIcon Data="M16 9v10H8V9h8m-1.5-6h-5l-1 1H5v2h14V4h-3.5l-1-1zM18 7H6v12c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7z"
                                          Foreground="{ThemeResource ErrorBrush}" />
                              </Button>
                            </Grid>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Button Command="{Binding AddExerciseCommand}"
                          Style="{StaticResource TextButtonStyle}"
                          MinHeight="44">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                      <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                      <TextBlock Text="Lägg till övning" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Command="{Binding AddPassCommand}"
                Style="{StaticResource OutlinedButtonStyle}"
                MinHeight="44">
          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
            <TextBlock Text="Lägg till pass" />
          </StackPanel>
        </Button>

        <!-- Felet visas även här: man trycker Spara längst ner och såg annars inte felet högst upp. -->
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{ThemeResource ErrorBrush}"
                   TextWrapping="Wrap" />
        <Button Content="{Binding SaveText}"
                Command="{Binding SaveCommand}"
                IsEnabled="{Binding IsIdle}"
                HorizontalAlignment="Stretch"
                MinHeight="44" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
