<ContentDialog x:Class="Tyngd.App.Presentation.Dialogs.StartFreeSessionDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:controls="using:Tyngd.App.Presentation.Controls"
               Title="Starta löst pass"
               CloseButtonText="Avbryt">
  <ScrollViewer>
    <StackPanel Spacing="12"
                MinWidth="280">
      <TextBlock Text="Välj första övningen. Passet startar direkt, och du lägger till nästa övning med &quot;+ Övning&quot; när du är klar."
                 Style="{StaticResource BodyMedium}"
                 Foreground="{ThemeResource OnSurfaceVariantBrush}"
                 TextWrapping="Wrap" />
      <ProgressBar x:Name="Progress"
                   IsIndeterminate="True"
                   Visibility="Collapsed" />
      <controls:FreeSessionExercisePicker x:Name="Picker"
                                          ExercisePicked="OnExercisePicked" />
      <TextBlock x:Name="ErrorText"
                 Foreground="{ThemeResource ErrorBrush}"
                 TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Assertive" />
    </StackPanel>
  </ScrollViewer>
</ContentDialog>
