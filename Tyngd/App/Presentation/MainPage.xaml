<Page x:Class="Tyngd.App.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <!-- Appens skal: flikarna i bottenmenyn (som BottomNav.razor i webbappen) växlar innehållet ovanför. -->
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid uen:Region.Attached="True"
          uen:Region.Navigator="Visibility">
      <StackPanel uen:Region.Name="Oversikt"
                  Padding="24"
                  Spacing="8">
        <TextBlock Text="Översikt"
                   Style="{StaticResource HeadlineMedium}" />
        <TextBlock Text="{Binding Greeting}"
                   Style="{StaticResource BodyLarge}"
                   AutomationProperties.AutomationId="MainGreeting" />
      </StackPanel>

      <TextBlock uen:Region.Name="Splits"
                 Visibility="Collapsed"
                 Text="Mina splits – kommer snart"
                 Style="{StaticResource TitleMedium}"
                 Margin="24" />

      <TextBlock uen:Region.Name="Mallar"
                 Visibility="Collapsed"
                 Text="Split-mallar – kommer snart"
                 Style="{StaticResource TitleMedium}"
                 Margin="24" />

      <TextBlock uen:Region.Name="Ovningar"
                 Visibility="Collapsed"
                 Text="Övningar – kommer snart"
                 Style="{StaticResource TitleMedium}"
                 Margin="24" />

      <ScrollViewer uen:Region.Name="Installningar"
                    Visibility="Collapsed">
        <StackPanel Padding="24"
                    Spacing="16">
          <TextBlock Text="Inställningar"
                     Style="{StaticResource HeadlineMedium}" />
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Mörkt läge"
                       Style="{StaticResource BodyLarge}"
                       VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1"
                          IsOn="{Binding IsDarkMode, Mode=TwoWay}"
                          OnContent=""
                          OffContent=""
                          AutomationProperties.Name="Mörkt läge"
                          AutomationProperties.AutomationId="DarkModeSwitch" />
          </Grid>
          <TextBlock Text="{Binding UserName}"
                     Style="{StaticResource BodyMedium}" />
          <Button Content="Logga ut"
                  Command="{Binding LogoutCommand}"
                  AutomationProperties.AutomationId="LogoutButton" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <utu:TabBar Grid.Row="1"
                Style="{StaticResource BottomTabBarStyle}"
                uen:Region.Attached="True">
      <utu:TabBarItem Content="Översikt"
                      uen:Region.Name="Oversikt">
        <utu:TabBarItem.Icon>
          <PathIcon Data="M19 5v2h-4V5h4M9 5v6H5V5h4m10 8v6h-4v-6h4M9 17v2H5v-2h4M21 3h-8v6h8V3zM11 3H3v10h8V3zm10 8h-8v10h8V11zm-10 4H3v6h8v-6z" />
        </utu:TabBarItem.Icon>
      </utu:TabBarItem>
      <utu:TabBarItem Content="Splits"
                      uen:Region.Name="Splits">
        <utu:TabBarItem.Icon>
          <PathIcon Data="M11.99 18.54l-7.37-5.73L3 14.07l9 7 9-7-1.63-1.27zM12 16l7.36-5.73L21 9l-9-7-9 7 1.63 1.27L12 16zm0-11.47L17.74 9 12 13.47 6.26 9 12 4.53z" />
        </utu:TabBarItem.Icon>
      </utu:TabBarItem>
      <utu:TabBarItem Content="Mallar"
                      uen:Region.Name="Mallar">
        <utu:TabBarItem.Icon>
          <PathIcon Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12zM10 9h8v2h-8zm0 3h4v2h-4zm0-6h8v2h-8z" />
        </utu:TabBarItem.Icon>
      </utu:TabBarItem>
      <utu:TabBarItem Content="Övningar"
                      uen:Region.Name="Ovningar">
        <utu:TabBarItem.Icon>
          <PathIcon Data="M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 5.57 4.14 4.14 2.71 2.71 4.14l1.43 1.43L2 7.71l1.43 1.43L2 10.57 3.43 12 7 8.43 15.57 17 12 20.57 13.43 22l1.43-1.43L16.29 22l2.14-2.14 1.43 1.43 1.43-1.43-1.43-1.43L22 16.29l-1.43-1.43z" />
        </utu:TabBarItem.Icon>
      </utu:TabBarItem>
      <utu:TabBarItem Content="Inställningar"
                      uen:Region.Name="Installningar">
        <utu:TabBarItem.Icon>
          <PathIcon Data="M19.43 12.98c.04-.32.07-.64.07-.98 0-.34-.03-.66-.07-.98l2.11-1.65c.19-.15.24-.42.12-.64l-2-3.46c-.09-.16-.26-.25-.44-.25-.06 0-.12.01-.17.03l-2.49 1c-.52-.4-1.08-.73-1.69-.98l-.38-2.65C14.46 2.18 14.25 2 14 2h-4c-.25 0-.46.18-.49.42l-.38 2.65c-.61.25-1.17.59-1.69.98l-2.49-1c-.06-.02-.12-.03-.18-.03-.17 0-.34.09-.43.25l-2 3.46c-.13.22-.07.49.12.64l2.11 1.65c-.04.32-.07.65-.07.98 0 .33.03.66.07.98l-2.11 1.65c-.19.15-.24.42-.12.64l2 3.46c.09.16.26.25.44.25.06 0 .12-.01.17-.03l2.49-1c.52.4 1.08.73 1.69.98l.38 2.65c.03.24.24.42.49.42h4c.25 0 .46-.18.49-.42l.38-2.65c.61-.25 1.17-.59 1.69-.98l2.49 1c.06.02.12.03.18.03.17 0 .34-.09.43-.25l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.65zm-1.98-1.71c.04.31.05.52.05.73 0 .21-.02.43-.05.73l-.14 1.13.89.7 1.08.84-.7 1.21-1.27-.51-1.04-.42-.9.68c-.43.32-.84.56-1.25.73l-1.06.43-.16 1.13-.2 1.35h-1.4l-.19-1.35-.16-1.13-1.06-.43c-.43-.18-.83-.41-1.23-.71l-.91-.7-1.06.43-1.27.51-.7-1.21 1.08-.84.89-.7-.14-1.13c-.03-.31-.05-.54-.05-.74s.02-.43.05-.73l.14-1.13-.89-.7-1.08-.84.7-1.21 1.27.51 1.04.42.9-.68c.43-.32.84-.56 1.25-.73l1.06-.43.16-1.13.2-1.35h1.39l.19 1.35.16 1.13 1.06.43c.43.18.83.41 1.23.71l.91.7 1.06-.43 1.27-.51.7 1.21-1.07.85-.89.7.14 1.13zM12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm0 6c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" />
        </utu:TabBarItem.Icon>
      </utu:TabBarItem>
    </utu:TabBar>
  </Grid>
</Page>
