<Page x:Class="Tyngd.App.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Tyngd.App.Presentation"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:controls="using:Tyngd.App.Presentation.Controls"
      Background="{ThemeResource BackgroundBrush}">
  <!-- Appens skal: flikarna i bottenmenyn (som BottomNav.razor i webbappen) växlar innehållet ovanför. -->
  <Grid utu:SafeArea.Insets="VisibleBounds,SoftInput">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Flikarnas sidor; MainPage.xaml.cs visar en i taget och skapar dess ViewModel första gången. -->
    <Grid>
      <local:OverviewPage x:Name="OverviewTab" />
      <local:MySplitsPage x:Name="SplitsTab" Visibility="Collapsed" />
      <local:TemplatesPage x:Name="TemplatesTab" Visibility="Collapsed" />
      <local:ExercisesPage x:Name="ExercisesTab" Visibility="Collapsed" />
      <local:SettingsPage x:Name="SettingsTab" Visibility="Collapsed" />
    </Grid>

    <!-- Pågående vila syns på alla flikar, som RestPill i webbappens appfält. -->
    <controls:RestPill Grid.Row="1"
                       Timer="{Binding RestTimer}"
                       HorizontalAlignment="Center"
                       Margin="0,8" />

    <utu:TabBar Grid.Row="2"
                x:Name="Tabs"
                Style="{StaticResource BottomTabBarStyle}"
                SelectedIndex="0"
                SelectionChanged="OnTabChanged">
      <utu:TabBarItem Content="Översikt">
        <utu:TabBarItem.Icon>
          <PathIcon Data="M19 5v2h-4V5h4M9 5v6H5V5h4m10 8v6h-4v-6h4M9 17v2H5v-2h4M21 3h-8v6h8V3zM11 3H3v10h8V3zm10 8h-8v10h8V11zm-10 4H3v6h8v-6z" />
        </utu:TabBarItem.Icon>
      </utu:TabBarItem>
      <utu:TabBarItem Content="Splits">
        <utu:TabBarItem.Icon>
          <PathIcon Data="M11.99 18.54l-7.37-5.73L3 14.07l9 7 9-7-1.63-1.27zM12 16l7.36-5.73L21 9l-9-7-9 7 1.63 1.27L12 16zm0-11.47L17.74 9 12 13.47 6.26 9 12 4.53z" />
        </utu:TabBarItem.Icon>
      </utu:TabBarItem>
      <utu:TabBarItem Content="Mallar">
        <utu:TabBarItem.Icon>
          <PathIcon Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12zM10 9h8v2h-8zm0 3h4v2h-4zm0-6h8v2h-8z" />
        </utu:TabBarItem.Icon>
      </utu:TabBarItem>
      <utu:TabBarItem Content="Övningar">
        <utu:TabBarItem.Icon>
          <PathIcon Data="M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 5.57 4.14 4.14 2.71 2.71 4.14l1.43 1.43L2 7.71l1.43 1.43L2 10.57 3.43 12 7 8.43 15.57 17 12 20.57 13.43 22l1.43-1.43L16.29 22l2.14-2.14 1.43 1.43 1.43-1.43-1.43-1.43L22 16.29l-1.43-1.43z" />
        </utu:TabBarItem.Icon>
      </utu:TabBarItem>
      <utu:TabBarItem Content="Inställningar">
