<Page x:Class="Tyngd.App.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <StackPanel utu:SafeArea.Insets="VisibleBounds"
              Spacing="16"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
    <TextBlock Text="{Binding Greeting}"
               Style="{StaticResource TitleLarge}"
               AutomationProperties.AutomationId="MainGreeting" />
    <Button Content="Logga ut"
            Command="{Binding LogoutCommand}"
            AutomationProperties.AutomationId="LogoutButton"
            HorizontalAlignment="Center" />
  </StackPanel>
</Page>
