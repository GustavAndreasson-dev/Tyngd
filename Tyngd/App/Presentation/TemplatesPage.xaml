<Page x:Class="Tyngd.App.Presentation.TemplatesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource BackgroundBrush}">
  <ScrollViewer>
    <StackPanel Padding="16,24"
                Spacing="16">
      <TextBlock Text="Split-mallar"
                 Style="{StaticResource HeadlineMedium}" />
      <ProgressRing IsActive="{Binding IsLoading}"
                    Visibility="{Binding IsLoading}"
                    HorizontalAlignment="Left" />
      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="{ThemeResource ErrorBrush}"
                 TextWrapping="Wrap" />

      <ItemsControl ItemsSource="{Binding Templates}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{ThemeResource SurfaceBrush}"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,0,16">
              <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding SplitName}"
                             Style="{StaticResource TitleLarge}"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="1"
                          Command="{Binding ToggleCommand}"
                          Visibility="{Binding IsActive}"
                          MinHeight="44">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                      <PathIcon Width="18"
                                Height="18"
                                Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm4.59-12.42L10 14.17l-2.59-2.58L6 13l4 4 8-8z" />
                      <TextBlock Text="Aktiverad" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="1"
                          Command="{Binding ToggleCommand}"
                          Visibility="{Binding IsInactive}"
                          Style="{StaticResource OutlinedButtonStyle}"
                          MinHeight="44">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                      <PathIcon Width="18"
                                Height="18"
                                Data="M13 7h-2v4H7v2h4v4h2v-4h4v-2h-4V7zm-1-5C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" />
                      <TextBlock Text="Aktivera" />
                    </StackPanel>
                  </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding Passes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Expander Header="{Binding PassName}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Margin="0,0,0,4">
                        <ItemsControl ItemsSource="{Binding Exercises}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource TitleSmall}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}"
                                           Style="{StaticResource BodySmall}"
                                           Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Expander>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Page>
