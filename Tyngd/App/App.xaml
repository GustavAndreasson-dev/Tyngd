<Application x:Class="Tyngd.App.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:um="using:Uno.Material">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <utum:MaterialToolkitTheme
          xmlns:utum="using:Uno.Toolkit.UI.Material"
          ColorOverrideSource="ms-appx:///Styles/ColorPaletteOverride.xaml">
          <!-- NOTE: You can override the default Roboto font by providing your font assets here. -->
          <!-- <utum:MaterialToolkitTheme.FontOverrideDictionary>
            <ResourceDictionary>
              <FontFamily x:Key="MaterialLightFontFamily">ms-appx:///Uno.Fonts.Roboto/Fonts/Roboto-Light.ttf#Roboto</FontFamily>
              <FontFamily x:Key="MaterialMediumFontFamily">ms-appx:///Uno.Fonts.Roboto/Fonts/Roboto-Medium.ttf#Roboto</FontFamily>
              <FontFamily x:Key="MaterialRegularFontFamily">ms-appx:///Uno.Fonts.Roboto/Fonts/Roboto-Regular.ttf#Roboto</FontFamily>
            </ResourceDictionary>
          </utum:MaterialToolkitTheme.FontOverrideDictionary> -->
        </utum:MaterialToolkitTheme>
      </ResourceDictionary.MergedDictionaries>

      <!-- Kontroller utan Material-stil (t.ex. NumberBox) använder Windows accentfärg (blå); ge dem appens primärfärg. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="SystemAccentColor">#57737A</Color>
          <Color x:Key="SystemAccentColorLight1">#57737A</Color>
          <Color x:Key="SystemAccentColorLight2">#57737A</Color>
          <Color x:Key="SystemAccentColorLight3">#57737A</Color>
          <Color x:Key="SystemAccentColorDark1">#57737A</Color>
          <Color x:Key="SystemAccentColorDark2">#57737A</Color>
          <Color x:Key="SystemAccentColorDark3">#57737A</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="SystemAccentColor">#C9FBFF</Color>
          <Color x:Key="SystemAccentColorLight1">#C9FBFF</Color>
          <Color x:Key="SystemAccentColorLight2">#C9FBFF</Color>
          <Color x:Key="SystemAccentColorLight3">#C9FBFF</Color>
          <Color x:Key="SystemAccentColorDark1">#C9FBFF</Color>
          <Color x:Key="SystemAccentColorDark2">#C9FBFF</Color>
          <Color x:Key="SystemAccentColorDark3">#C9FBFF</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

    </ResourceDictionary>
  </Application.Resources>

</Application>
