<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-desktop</TargetFrameworks>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- NETSDK1201: RID ger inte self-contained app. PRI257: standardspråket en saknas bland resurserna. -->
    <NoWarn>$(NoWarn);NETSDK1201;PRI257</NoWarn>

    <OutputType>Exe</OutputType>
    <!-- Android 8 (API 26) eller senare: notiskanaler för vilotimern. -->
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">26.0</SupportedOSPlatformVersion>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Tyngd</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>se.tyngd.app</ApplicationId>
    <!-- Versions -->
    <!-- Byggtid (UTC) som version, som webbappen; visas i Inställningar och som Androids versionsnamn. -->
    <Version>$([System.DateTime]::UtcNow.ToString("yyyy.M.d.HHmm"))</Version>
    <!-- Bara Android: desktopbyggets Resizetizer kräver en semver med tre delar. -->
    <ApplicationDisplayVersion Condition="$(TargetFramework.Contains('-android'))">$(Version)</ApplicationDisplayVersion>
    <ApplicationDisplayVersion Condition="!$(TargetFramework.Contains('-android'))">1.0.0</ApplicationDisplayVersion>
    <!-- Måste ökas vid varje release till Play. -->
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Tyngd</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Tyngd – träningslogg.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Material;
      Hosting;
      Toolkit;
      Logging;
      Mvvm;
      Configuration;
      Http;
      Serialization;
      Navigation;
      ThemeService;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Tyngd.Shared.csproj" />
    <ProjectReference Include="..\Client.Core\Tyngd.Client.Core.csproj" />
  </ItemGroup>

</Project>
