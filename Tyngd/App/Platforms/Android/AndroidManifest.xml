<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Exakt larm när vilan är slut: utan det kom larmet upp till ett par minuter för sent (testat).
       USE_EXACT_ALARM ges automatiskt från Android 13 till timer-appar; äldre versioner frågar via SCHEDULE_EXACT_ALARM. -->
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
  <application android:allowBackup="false" android:supportsRtl="true">
  </application>
</manifest>
