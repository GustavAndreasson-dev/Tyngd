@using Tyngd.Shared.DTOs

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Ändra ordning</MudText>
    </TitleContent>
    <DialogContent>
        <MudTabs Rounded="true" Class="reorder-tabs">
            <MudTabPanel Text="Pass">
                <div class="reorder-mode">
                    <div class="reorder-list">
                        @for (var passIndex = 0; passIndex < orderedPasses.Count; passIndex++)
                        {
                            var currentPassIndex = passIndex;
                            var pass = orderedPasses[currentPassIndex];

                            <div @key="pass"
                                 class="reorder-item d-flex align-center"
                                 style="gap:8px;"
                                 draggable="true"
                                 @ondragstart="@(() => BeginPassDrag(currentPassIndex))"
                                 @ondragend="ClearPassDrag"
                                 @ondragover:preventDefault
                                 @ondrop="@(() => DropPass(currentPassIndex))">
                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator"
                                         Color="Color.Secondary" />
                                <span class="reorder-position">@(currentPassIndex + 1)</span>
                                <MudText Typo="Typo.subtitle1"
                                         Style="flex:1 1 auto; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                    @PassName(pass, currentPassIndex)
                                </MudText>
                                <div class="reorder-actions d-flex"
                                     style="flex:0 0 auto;"
                                     @ondragstart:stopPropagation>
                                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                                   Size="Size.Small"
                                                   Disabled="@(currentPassIndex == 0)"
                                                   aria-label="Flytta pass upp"
                                                   OnClick="@(() => MovePass(currentPassIndex, -1))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                                   Size="Size.Small"
                                                   Disabled="@(currentPassIndex == orderedPasses.Count - 1)"
                                                   aria-label="Flytta pass ned"
                                                   OnClick="@(() => MovePass(currentPassIndex, 1))" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="Övningar">
                <div class="reorder-mode">
                    @if (orderedPasses.Count > 0)
                    {
                        <MudSelect T="int"
                                   @bind-Value="SelectedPassIndex"
                                   Label="Pass"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="mb-3">
                            @for (var passIndex = 0; passIndex < orderedPasses.Count; passIndex++)
                            {
                                var currentPassIndex = passIndex;
                                var pass = orderedPasses[currentPassIndex];

                                <MudSelectItem T="int" Value="@currentPassIndex">
                                    @PassName(pass, currentPassIndex)
                                </MudSelectItem>
                            }
                        </MudSelect>

                        @if (selectedPass is not null && selectedPass.Exercises.Count > 0)
                        {
                            <div class="reorder-list">
                                @for (var exerciseIndex = 0; exerciseIndex < selectedPass.Exercises.Count; exerciseIndex++)
                                {
                                    var currentExerciseIndex = exerciseIndex;
                                    var exercise = selectedPass.Exercises[currentExerciseIndex];

                                    <div @key="exercise"
                                         class="reorder-item d-flex align-center"
                                         style="gap:8px;"
                                         draggable="true"
                                         @ondragstart="@(() => BeginExerciseDrag(selectedPass, currentExerciseIndex))"
                                         @ondragend="ClearExerciseDrag"
                                         @ondragover:preventDefault
                                         @ondrop="@(() => DropExercise(selectedPass, currentExerciseIndex))">
                                        <MudIcon Icon="@Icons.Material.Filled.DragIndicator"
                                                 Color="Color.Secondary" />
                                        <span class="reorder-position">@(currentExerciseIndex + 1)</span>
                                        <MudText Typo="Typo.body1"
                                                 Style="flex:1 1 auto; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                            @ExerciseName(exercise, currentExerciseIndex)
                                        </MudText>
                                        <div class="reorder-actions d-flex"
                                             style="flex:0 0 auto;"
                                             @ondragstart:stopPropagation>
                                            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                                           Size="Size.Small"
                                                           Disabled="@(currentExerciseIndex == 0)"
                                                           aria-label="Flytta övning upp"
                                                           OnClick="@(() => MoveExercise(selectedPass, currentExerciseIndex, -1))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                                           Size="Size.Small"
                                                           Disabled="@(currentExerciseIndex == selectedPass.Exercises.Count - 1)"
                                                           aria-label="Flytta övning ned"
                                                           OnClick="@(() => MoveExercise(selectedPass, currentExerciseIndex, 1))" />
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="reorder-empty">
                                Inga övningar
                            </MudText>
                        }
                    }
                </div>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Avbryt</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Apply">
            Använd ordning
        </MudButton>
    </DialogActions>
</MudDialog>
