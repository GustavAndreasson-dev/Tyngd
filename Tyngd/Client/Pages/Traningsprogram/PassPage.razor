@page "/TP/split/{SplitId:int}/pass/{PassId:int}"
@layout MainLayout
@inherits PageComponentBase
@using Tyngd.Client.Services

<PageTitle>@pass?.PassName</PageTitle>

<ErrorAlert Message="@ErrorMessage" OnClose="ClearError" />

@if (!string.IsNullOrWhiteSpace(saveStatusMessage))
{
    <MudAlert Severity="@saveStatusSeverity" Dense="true" ShowCloseIcon="true" CloseIconClicked="ClearSaveStatus" Class="mb-4">
        @saveStatusMessage
    </MudAlert>
}

@if (pass is not null)
{
    var count = pass.Exercises.Count;
    var hasActive = activeIndex >= 0 && activeIndex < count;
    <div class="pass @(RestTimer.IsResting ? "pass--resting" : "")">
        <header class="pass-head">
            <div>
                <span class="ui-label">Övning @(activeIndex + 1) av @count</span>
                <h1 class="ui-title">@pass.PassName</h1>
            </div>
            <div class="pass-head__side">
                <span class="ui-sub">@DoneSets / @TotalSets set</span>
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.AccessibilityNew"
                           OnClick="ToggleMuscles" aria-expanded="@showMuscles">Muskler</MudButton>
            </div>
        </header>
        @if (showMuscles)
        {
            <section class="ui-card pass-muscles" aria-label="Muskler i passet">
                @if (passMuscleLoad is null)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else
                {
                    <MuscleMap Load="passMuscleLoad" />
                }
            </section>
        }
        <div class="pass-progress" role="progressbar" aria-valuemin="0" aria-valuemax="@TotalSets" aria-valuenow="@DoneSets">
            <div style="width:@(TotalSets == 0 ? 0 : DoneSets * 100 / TotalSets)%"></div>
        </div>

        <nav class="pass-chips" aria-label="Övningar">
            @for (int i = 0; i < count; i++)
            {
                var idx = i;
                <button type="button" class="@ChipClass(idx)" @onclick="() => NavigateToExercise(idx)">
                    <span class="pass-chip__n">@(idx + 1)</span>@pass.Exercises[idx].Exercise.ExerciseName
                </button>
            }
            @if (pass.IsFreeSession)
            {
                <button type="button" class="pass-chip pass-chip--add" disabled="@addingExercise" @onclick="AddFreeExercise">+ Övning</button>
            }
        </nav>

        @if (hasActive)
        {
            var exercise = pass.Exercises[activeIndex];
            <section class="ui-card pass-exercise" aria-labelledby="ex-name">
                <div class="pass-exercise__top">
                    <div>
                        <h2 id="ex-name" class="pass-exercise__name">
                            @exercise.Exercise.ExerciseName
                            @if (exercise.CatalogExerciseId is { } catalogExerciseId)
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Class="pass-exercise__info"
                                               aria-label="Om övningen" OnClick="@(() => ShowExerciseInfo(catalogExerciseId))" />
                            }
                            @if (pass.IsFreeSession && count > 1)
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Class="pass-exercise__info"
                                               aria-label="Ta bort övningen" OnClick="@(() => RemoveFreeExercise(exercise.ExerciseId, exercise.Exercise.ExerciseName))" />
                            }
                        </h2>
                        <span class="ui-sub">@ExerciseFormat.SetsReps(exercise)@PreviousWeight(exercise.ExerciseId)</span>
                    </div>
                    <MudNumericField T="decimal?" Label="Vikt" HideSpinButtons="true" Variant="Variant.Outlined" Format="0.##" Min="0" Max="400" Adornment="Adornment.End" AdornmentText="kg" Value="GetWeight(exercise.ExerciseId)" ValueChanged="v => SetWeight(exercise.ExerciseId, v)" OnBlur="OnWeightChanged" Class="weight-field pass-weight" />
                </div>

                <div class="slider-wrapper pass-sets">
                    @for (int s = 0; s < exercise.DefaultSets; s++)
                    {
                        var setIndex = s;
                        var currentExercise = exercise;
                        var done = IsSetDone(currentExercise.ExerciseId, setIndex);
                        var prevSet = PreviousSet(currentExercise.ExerciseId, setIndex);
                        <div class="pass-set @(done ? "pass-set--done" : "")">
                            <span class="pass-set__n">
                                Set @(setIndex + 1)
                                @if (prevSet is not null)
                                {
                                    var reps = (int)GetReps(currentExercise.ExerciseId, setIndex);
                                    <small class="@(reps > prevSet.Reps ? "pass-set__prev pass-set__prev--up" : "pass-set__prev")">förra @prevSet.Reps@(reps > prevSet.Reps ? " ↑" : "")</small>
                                }
                            </span>
                            <div class="pass-set__reps">
                                <button type="button" class="pass-step" aria-label="Minska reps" @onclick="() => AdjustReps(currentExercise.ExerciseId, setIndex, -1)">−</button>
                                <span class="pass-set__count">@((int)GetReps(currentExercise.ExerciseId, setIndex))<small>reps</small></span>
                                <button type="button" class="pass-step" aria-label="Öka reps" @onclick="() => AdjustReps(currentExercise.ExerciseId, setIndex, 1)">+</button>
                            </div>
                            <button type="button" class="pass-check @(done ? "pass-check--on" : "")" aria-pressed="@(done ? "true" : "false")" aria-label="@(done ? "Ångra set klart" : "Markera set klart")" @onclick="() => ToggleSet(currentExercise.ExerciseId, setIndex)">
                                <MudIcon Icon="@Icons.Material.Filled.Check" />
                            </button>
                        </div>
                    }
                </div>

                @if (_previous.TryGetValue(exercise.ExerciseId, out var prevNoteExercise) && !string.IsNullOrWhiteSpace(prevNoteExercise.NoteText))
                {
                    <p class="pass-prev-note"><span class="ui-label">Förra anteckningen</span>@prevNoteExercise.NoteText</p>
                }
                <MudTextField T="string"
                              Label="Anteckningar"
                              Lines="2"
                              Variant="Variant.Outlined"
                              Value="@GetNote(exercise.ExerciseId)"
                              ValueChanged="v => SetNote(exercise.ExerciseId, v)"
                              OnBlur="OnNoteChanged"
                              Class="note-field" />

                @{ var points = ActiveProgress; }
                @if (points.Count >= 2)
                {
                    <div class="pass-progress-card">
                        <div class="pass-row">
                            <span class="ui-label">Viktutveckling</span>
                            <span class="ui-sub">@WeightProgress.Summary(points)</span>
                        </div>
                        <svg viewBox="0 0 300 80" preserveAspectRatio="none" role="img" aria-label="Viktutveckling de senaste @points.Count passen">
                            <polyline points="@SparkPoints(points)" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
                        </svg>
                    </div>
                }
            </section>
        }
    </div>

    @if (RestTimer.IsResting)
    {
        <div class="pass-rest" role="timer" aria-label="Vilotimer">
            <div class="pass-rest__row">
                <span class="ui-label">Vila</span>
                <span class="pass-rest__time">@($"{RestTimer.RemainingSeconds / 60}:{RestTimer.RemainingSeconds % 60:00}")</span>
                <button type="button" class="pass-rest__skip" @onclick="CancelRestTimer">Hoppa över</button>
            </div>
            <div class="pass-rest__track"><div style="width:@(RestTimer.PercentLeft)%"></div></div>
        </div>
    }
    <div class="pass-bar">
        <button type="button" class="ui-btn pass-bar__side" disabled="@(activeIndex <= 0)" @onclick="() => NavigateToExercise(activeIndex - 1)" aria-label="Föregående övning">‹</button>
        <div class="pass-bar__mid">
            <button type="button" class="ui-btn pass-bar__main @(AllSetsDone() ? "" : "pass-bar__main--early")" @onclick="EndPass">Avsluta pass</button>
            @if (!AllSetsDone())
            {
                <span class="ui-sub">@DoneSets av @TotalSets set klara</span>
            }
        </div>
        <button type="button" class="ui-btn pass-bar__side" disabled="@(activeIndex >= count - 1)" @onclick="() => NavigateToExercise(activeIndex + 1)" aria-label="Nästa övning">›</button>
    </div>
}
else
{
    <MudText>Passet hittades inte.</MudText>
}
