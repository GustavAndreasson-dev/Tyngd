@using Tyngd.Shared.Catalog
@using Tyngd.Client.Services
@namespace Tyngd.Client.Shared

<MudDialog>
    <DialogContent>
        @if (_exercise is not null)
        {
            <div class="d-flex align-center" style="gap:4px;">
                <MudText Typo="Typo.h6" Style="flex:1;">@_exercise.Name</MudText>
                @if (LoginState.IsLoggedIn)
                {
                    <MudIconButton Icon="@(_isFavorite ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                                   Color="@(_isFavorite ? Color.Warning : Color.Default)" Size="Size.Small"
                                   aria-label="@(_isFavorite ? "Ta bort från favoriter" : "Spara som favorit")"
                                   OnClick="ToggleFavorite" />
                }
            </div>
            @if (!string.Equals(_exercise.Name, _exercise.NameEn, StringComparison.OrdinalIgnoreCase))
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">@_exercise.NameEn</MudText>
            }
        }
        @if (_error is not null)
        {
            <MudText Color="Color.Error">@_error</MudText>
        }
        else if (_exercise is null)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
        else
        {
            @if (_exercise.ImageUrl is not null)
            {
                <img src="@_exercise.ImageUrl" alt="@_exercise.Name" loading="lazy"
                     style="max-width:100%; max-height:220px; display:block; margin:0 auto 12px; border-radius:8px; background:#fff;" />
            }
            <div class="d-flex flex-wrap mb-3" style="gap:4px;">
                @if (!_exercise.Muscles.Contains(_exercise.Category))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@_exercise.Category</MudChip>
                }
                @foreach (var muscle in _exercise.Muscles)
                {
                    <MudChip T="string" Size="Size.Small">@muscle</MudChip>
                }
                @foreach (var item in _exercise.Equipment)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@item</MudChip>
                }
            </div>
            <div class="mb-3">
                <MuscleMap Load="_load" EmptyText="wger anger inga muskler för övningen." />
            </div>
            @if (_history is { Count: > 0 })
            {
                <MudText Typo="Typo.subtitle2" Class="mb-1">Din historik</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1">
                    Bästa vikt: @(_history.Max(entry => entry.MaxWeight).ToString("0.##")) kg · @_history.Count senaste tillfällen från alla pass
                </MudText>
                <ul class="mb-3" style="list-style:none; padding:0; margin:0; font-size:.875rem;">
                    @foreach (var entry in Enumerable.Reverse(_history).Take(5))
                    {
                        <li style="display:flex; justify-content:space-between; gap:8px; padding:2px 0;">
                            <span>@SvDate.Short(entry.Date) · @entry.PassName</span>
                            <span style="font-variant-numeric:tabular-nums;">@entry.MaxWeight.ToString("0.##") kg · @entry.Sets set · @entry.TotalReps reps</span>
                        </li>
                    }
                </ul>
            }
            @if (string.IsNullOrWhiteSpace(_exercise.Description))
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Ingen beskrivning finns.</MudText>
            }
            else
            {
                @* Ren text från servern; pre-line behåller stycken och listrader. *@
                <MudText Typo="Typo.body2" Style="white-space: pre-line;">@_exercise.Description</MudText>
            }
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-4" Style="opacity:.75;">
                Övningsdata från <a href="https://wger.de" target="_blank" rel="noopener">wger.de</a>
                @if (!string.IsNullOrWhiteSpace(_exercise.License))
                {
                    <span> · @_exercise.License</span>
                }
                @if (!string.IsNullOrWhiteSpace(_exercise.LicenseAuthor))
                {
                    <span> · @_exercise.LicenseAuthor</span>
                }
                @if (_exercise.ImageUrl is not null && (!string.IsNullOrWhiteSpace(_exercise.ImageAuthor) || !string.IsNullOrWhiteSpace(_exercise.ImageLicense)))
                {
                    <br />
                    <span>Bild: @(string.Join(", ", new[] { _exercise.ImageAuthor, _exercise.ImageLicense }.Where(part => !string.IsNullOrWhiteSpace(part))))</span>
                }
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close())">Stäng</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Inject] private CatalogService CatalogService { get; set; } = default!;
    [Inject] private FavoritesService FavoritesService { get; set; } = default!;
    [Inject] private LoginState LoginState { get; set; } = default!;
    [Inject] private PassLogService PassLogService { get; set; } = default!;

    [Parameter] public int CatalogExerciseId { get; set; }

    private CatalogExerciseDetailDto? _exercise;
    private Dictionary<string, double>? _load;
    private bool _isFavorite;
    private List<Tyngd.Shared.DTOs.ExerciseHistoryEntryDto>? _history;

    private async Task ToggleFavorite()
    {
        try { _isFavorite = await FavoritesService.ToggleAsync(CatalogExerciseId); }
        catch (HttpRequestException) { }
    }
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _exercise = await CatalogService.GetAsync(CatalogExerciseId);
            if (_exercise is null)
                _error = "Övningen hittades inte.";
            else
            {
                _load = MuscleLoad.Sum([(_exercise.PrimaryMuscles, _exercise.SecondaryMuscles)]);
                _isFavorite = (await FavoritesService.GetAsync()).Contains(CatalogExerciseId);
                if (LoginState.IsLoggedIn)
                    _history = await PassLogService.GetCatalogHistoryAsync(CatalogExerciseId);
            }
        }
        catch (HttpRequestException)
        {
            _error = "Kunde inte hämta övningen. Kontrollera anslutningen.";
        }
    }
}
