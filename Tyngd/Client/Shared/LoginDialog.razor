@using MudBlazor
@namespace Tyngd.Client.Shared

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Logga in</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_username"
                      Label="Användarnamn eller e-post"
                      Variant="Variant.Filled"
                      Class="mb-4"
                      Immediate="true" />
        <MudTextField @bind-Value="_password"
                      Label="Lösenord"
                      Variant="Variant.Filled"
                      InputType="InputType.Password"
                      Immediate="true"
                      OnKeyDown="OnKeyDown" />
        @if (_errorMessage is not null)
        {
            <MudText Color="Color.Error" Class="mt-2">@_errorMessage</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Avbryt</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">Logga in</MudButton>
    </DialogActions>
</MudDialog>
