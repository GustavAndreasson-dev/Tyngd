@using Tyngd.Shared.Catalog
@namespace Tyngd.Client.Shared

@* Kroppsfigur (wgers bilder) med tränade muskler i lager ovanpå. Tryck eller använd knappen för att vända. *@
@if (_muscles.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">@EmptyText</MudText>
}
else
{
    <div class="muscle-map">
        <button type="button" class="muscle-map__card"
                aria-label="@(_showBack ? "Visar baksidan. Tryck för att visa framsidan." : "Visar framsidan. Tryck för att visa baksidan.")"
                @onclick="Flip">
            <div class="muscle-map__inner @(_showBack ? "muscle-map__inner--back" : "")">
            <div class="muscle-map__face">
                <img class="muscle-map__layer" src="img/muscles/front.svg" alt="" />
                @foreach (var muscle in _muscles.Where(m => m.Muscle.IsFront))
                {
                    <img class="muscle-map__layer" src="@Src(muscle)" style="opacity:@Opacity(muscle)" alt="" />
                }
            </div>
            <div class="muscle-map__face muscle-map__face--back">
                <img class="muscle-map__layer" src="img/muscles/back.svg" alt="" />
                @foreach (var muscle in _muscles.Where(m => !m.Muscle.IsFront))
                {
                    <img class="muscle-map__layer" src="@Src(muscle)" style="opacity:@Opacity(muscle)" alt="" />
                }
            </div>
            </div>
        </button>
        <div class="muscle-map__side">
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.FlipCameraAndroid" OnClick="Flip">
                @(_showBack ? "Visa framsidan" : "Visa baksidan")
            </MudButton>
            <ul class="muscle-map__legend">
                @foreach (var muscle in _muscles.Take(MaxLegend))
                {
                    <li>
                        <span class="muscle-map__dot @(muscle.IsStrong ? "muscle-map__dot--strong" : "")"></span>
                        @muscle.Muscle.NameSv
                    </li>
                }
            </ul>
        </div>
    </div>
}

@code {
    private const int MaxLegend = 6;

    /// <summary>Belastning per muskelnyckel (se MuscleLoad). Skalas mot det högsta värdet.</summary>
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, double>? Load { get; set; }

    [Parameter] public string EmptyText { get; set; } = "Inga muskeldata. Övningar måste vara kopplade till katalogen.";

    private List<MuscleShare> _muscles = new();
    private bool _showBack;
    private IReadOnlyDictionary<string, double>? _shownLoad;

    protected override void OnParametersSet()
    {
        // Föräldern renderar om ofta (t.ex. vilotimern); räkna bara om när belastningen byts, så att vändningen står kvar.
        if (ReferenceEquals(Load, _shownLoad))
            return;
        _shownLoad = Load;

        _muscles = MuscleLoad.Scale(Load);
        _showBack = MuscleLoad.ShowBackFirst(_muscles);
    }

    private void Flip() => _showBack = !_showBack;

    private static string Src(MuscleShare item) =>
        $"img/muscles/muscle-{item.Muscle.WgerId}-{(item.IsStrong ? "main" : "secondary")}.svg";

    private static string Opacity(MuscleShare item) =>
        item.Opacity.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
}
