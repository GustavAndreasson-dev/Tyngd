@using Tyngd.Shared.DTOs
@using Tyngd.Shared.TrainingPrograms
@using Tyngd.Client.Services
@namespace Tyngd.Client.Shared
@inject FreeSessionService FreeSessionService
@inject UserSplitsService UserSplitsService

@* Visas när ett löst pass avslutats: spara det som ett riktigt pass, eller släng det. Träningen finns kvar i historiken oavsett. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Spara som pass?</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Det du tränat är sparat. Vill du kunna köra samma övningar igen? Spara dem som ett pass i en split.
        </MudText>
        <MudTextField @bind-Value="_passName" Label="Passnamn" Variant="Variant.Outlined" MaxLength="50" Class="mb-3" />
        <MudSelect T="int" @bind-Value="_target" Label="Spara i" Variant="Variant.Outlined" Class="mb-3">
            <MudSelectItem Value="NewSplit">Ny split</MudSelectItem>
            @foreach (var split in _splits)
            {
                <MudSelectItem Value="@split.SplitId">@split.SplitName</MudSelectItem>
            }
        </MudSelect>
        @if (_target == NewSplit)
        {
            <MudTextField @bind-Value="_newSplitName" Label="Splittens namn" Variant="Variant.Outlined" MaxLength="50" />
        }
        @if (_error is not null)
        {
            <MudText Color="Color.Error" Class="mt-2">@_error</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Error" Disabled="_busy" OnClick="Discard">Släng passet</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="Keep">Spara som pass</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const int NewSplit = 0;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int PassId { get; set; }
    [Parameter] public string PassName { get; set; } = string.Empty;

    private List<TrainingSplit> _splits = new();
    private string _passName = string.Empty;
    private string _newSplitName = "Mina pass";
    private int _target = NewSplit;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _passName = PassName;
        try { _splits = await UserSplitsService.GetMySplitsAsync(); }
        catch (HttpRequestException) { }
    }

    private async Task Keep()
    {
        _busy = true;
        _error = null;
        try
        {
            var kept = await FreeSessionService.KeepAsync(PassId, new KeepFreeSessionRequest
            {
                PassName = _passName,
                TargetSplitId = _target == NewSplit ? null : _target,
                NewSplitName = _target == NewSplit ? _newSplitName : null,
            });
            MudDialog.Close(DialogResult.Ok(kept));
        }
        catch (HttpRequestException)
        {
            _error = "Kunde inte spara. Kontrollera namnen (1–50 tecken) och anslutningen.";
            _busy = false;
        }
    }

    private async Task Discard()
    {
        _busy = true;
        try
        {
            await FreeSessionService.DiscardAsync(PassId);
        }
        catch (HttpRequestException)
        {
            // Passet syns ändå inte i några listor; det som tränats är sparat.
        }
        MudDialog.Close(DialogResult.Ok(false));
    }
}
