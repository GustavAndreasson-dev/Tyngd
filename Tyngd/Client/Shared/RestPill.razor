@using Tyngd.Client.Services
@namespace Tyngd.Client.Shared
@implements IDisposable
@inject RestTimerState RestTimer
@inject NavigationManager Nav

@* Vilan i sidhuvudet på alla sidor utom passet den startades från, som har en egen stor timer.
   Egen komponent så att bara den renderas om varje tick, inte hela layouten. *@
@if (RestTimer.IsResting && RestTimer.PassUrl is { } passUrl
     && !Nav.ToBaseRelativePath(Nav.Uri).StartsWith(passUrl, StringComparison.OrdinalIgnoreCase))
{
    <a class="rest-pill" href="@passUrl" role="timer" aria-label="Vila pågår, tryck för att gå till passet">
        <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" />
        @($"{RestTimer.RemainingSeconds / 60}:{RestTimer.RemainingSeconds % 60:00}")
    </a>
}

@code {
    protected override void OnInitialized()
    {
        RestTimer.OnTick += Refresh;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => Refresh();

    public void Dispose()
    {
        RestTimer.OnTick -= Refresh;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
